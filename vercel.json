{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.aqoon.live" }],
      "destination": "https://aqoon.live/$1",
      "permanent": true
    },
    { "source": "/palvelut", "destination": "/menetelma", "permanent": true },
    { "source": "/miksi", "destination": "/menetelma", "permanent": true },
    { "source": "/hinnat", "destination": "/paketit", "permanent": true },
    { "source": "/kenelle", "destination": "/", "permanent": true },
    { "source": "/yhteys", "destination": "/#yhteys", "permanent": true },
    { "source": "/pilke_landing.html", "destination": "/pilke", "permanent": true },
    { "source": "/pilke_landing_so.html", "destination": "/pilke/so", "permanent": true },

    { "source": "/so/suomen-kurssi", "destination": "/so/finnish-course", "permanent": true },
    { "source": "/so/takaisin-kouluun", "destination": "/so/dib-ugu-noqo-dugsi", "permanent": true },
    { "source": "/so/ammattikoulu", "destination": "/so/ammatillinen-koulutus", "permanent": true },
    { "source": "/so/paivakoti-hakemus", "destination": "/so/paivakoti-codsi", "permanent": true },
    { "source": "/so/ilmainen-harrastus", "destination": "/so/harrastus-ilmainen", "permanent": true },
    { "source": "/so/palveluseteli-paivakoti", "destination": "/so/palveluseteli", "permanent": true },
    { "source": "/so/paivakoti-vantaa", "destination": "/so/vantaa-paivakoti", "permanent": true },
    { "source": "/so/paivakoti-helsinki", "destination": "/so/helsinki-paivakoti", "permanent": true },
    { "source": "/so/paivakoti-espoo", "destination": "/so/espoo-paivakoti", "permanent": true },
    { "source": "/so/paivakoti-tampere", "destination": "/so/tampere-paivakoti", "permanent": true }
  ]
}
